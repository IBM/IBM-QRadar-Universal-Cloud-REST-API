<?xml version="1.0" encoding="UTF-8" ?>
<Workflow name="Vectra RUX" version="1.0"
    xmlns="http://qradar.ibm.com/UniversalCloudRESTAPI/Workflow/V2_1">

    <!-- Collect configurations from workflow parameter file -->
    <!-- historical parameter will not be used in this workflow -->
    <Parameters>
        <Parameter name="vectraHostName" label="Vectra Hostname" required="true"/>
        <Parameter name="clientId" label="Client ID" required="true"/>
        <Parameter name="historical" label="Historical Collection" required="false"/>
        <Parameter name="secretKey" label="Secret Key" secret="true" required="true" />
        <Parameter name="from" label="Initial Detection Event Checkpoint" required="false"/>
        <Parameter name="lookbackHours" label="Initial Lookback Hours" required="false"/>
        <Parameter name="includeInfoCategory" label="Include Info Category Detections" required="false"/>
        <Parameter name="includeTriaged" label="Include Triaged Detections" required="false"/>
        <Parameter name="collectEdrHealth" label="Collect EDR Health" required="true"/>
        <Parameter name="collectExternalConnectorsHealth" label="Collect External Connectors Health" required="true"/>
    </Parameters>

    <Actions>

        <!-- Clear status of log source -->
        <ClearStatus />

        <!-- Defining variables for running workflow -->
        <Set path="/vectraUrl" value="https://${/vectraHostName}"/>
        <Set path="/logPrefix" value="[Vectra_RUX_App_for_QRadar][Health][${/vectraUrl}]" />
        <Initialize path="/errorCount" value="0" />
        <Initialize path="/maxRetry" value="3" />
        <Initialize path="/createTokenEndpoint" value="/oauth2/token" />
        <Initialize path="/healthEndpoint" value="/api/v3.5/health" />
        <Initialize path="/healthEdrEndpoint" value="/api/v3.5/health/edr" />
        <Initialize path="/healthEdrDetailsEndpoint" value="/api/v3.5/health/edr/details" />
        <Initialize path="/healthExternalConnectorsEndpoint" value="/api/v3.5/health/external_connectors" />
        <Initialize path="/healthExternalConnectorsDetailsEndpoint" value="/api/v3.5/health/external_connectors/details" />
        <Initialize path="/refreshToken" value="" />
        <Initialize path="/defaultSleepTime" value="30" />
        <Initialize path="/appVersion" value="2.0.0" />
        <Initialize path="/userAgentHeader" value="Vectra-QRadar-${/appVersion}" />

        <!-- Print log in the /var/log/qradar.log file with info log level -->
        <Log type="INFO" message="${/logPrefix} - Health events collection started with collectEdrHealth: ${/collectEdrHealth}, collectExternalConnectorsHealth: ${/collectExternalConnectorsHealth}." />

        <!-- Validate the 'collectEdrHealth' parameter (expects enable/disable, case-insensitive). -->
        <If condition="${'${lower(/collectEdrHealth)}' != 'enable' and '${lower(/collectEdrHealth)}' != 'disable'}">
            <Log type="INFO" message="${/logPrefix} - Invalid collectEdrHealth value: ${/collectEdrHealth}. Must be one of: enable, disable" />
            <Abort reason="Invalid collectEdrHealth parameter. Must be one of: enable, disable" />
        </If>

        <!-- Validate the 'collectExternalConnectorsHealth' parameter (expects enable/disable, case-insensitive). -->
        <If condition="${'${lower(/collectExternalConnectorsHealth)}' != 'enable' and '${lower(/collectExternalConnectorsHealth)}' != 'disable'}">
            <Log type="INFO" message="${/logPrefix} - Invalid collectExternalConnectorsHealth value: ${/collectExternalConnectorsHealth}. Must be one of: enable, disable" />
            <Abort reason="Invalid collectExternalConnectorsHealth parameter. Must be one of: enable, disable" />
        </If>

        <!-- Step completion flags. They persist across re-authentication so that an already
             completed step (or sub-step) is not collected/ingested again after a token refresh. -->
        <Set path="/errorCount" value="0" />
        <Set path="/baseHealthCompleted" value="false" />
        <Set path="/edrSummaryCompleted" value="false" />
        <Set path="/edrDetailsCompleted" value="false" />
        <Set path="/externalSummaryCompleted" value="false" />
        <Set path="/externalDetailsCompleted" value="false" />

        <!-- Perform data collection continously in case of no error -->
        <While condition="${/errorCount != ${/maxRetry}}">

            <!-- Create Refresh Token if it is not created -->
            <If condition="${empty(/refreshToken)} = 'true'">

                <Log type="INFO" message="${/logPrefix} - Refresh token not found. Creating new Access and Refresh token using provided credentials." />

                <Set path="/rateLimitErrorCount" value="0" />
                <While condition="${/rateLimitErrorCount != ${/maxRetry}}">

                    <!-- Create Refresh token and Access Token using Client ID and secret and save response at Jpath /refreshTokenResponse -->
                    <CallEndpoint url="${/vectraUrl}${/createTokenEndpoint}" method="POST" savePath="/refreshTokenResponse">

                        <!-- Implicitly convert username and password in the format of basic authentication - "Basic Base64Encode(username:password)" -->
                        <BasicAuthentication username="${/clientId}" password="${/secretKey}" />

                        <!-- Request header -->
                        <RequestHeader name="User-Agent" value="${/userAgentHeader}" />

                        <!-- Request body in the urlencoded format -->
                        <UrlEncodedFormRequestBody>
                            <Parameter name="grant_type" value="client_credentials" />
                            <Parameter name="Accept" value="application/json" />
                            <Parameter name="content-type" value="application/x-www-form-urlencoded" />
                        </UrlEncodedFormRequestBody>
                    </CallEndpoint>

                    <!-- Retry 3 times if the status code is 429. i.e API Rate limit exceeded. -->
                    <If condition="${/refreshTokenResponse/status_code} = 429">
                        <Set path="/rateLimitErrorCount" value="${/rateLimitErrorCount + 1}" />
                        <Log type="INFO" message="${/logPrefix} - API Rate limit exceeded. Status Code: 429." />
                        <If condition="${/rateLimitErrorCount = ${/maxRetry}}">
                            <Log type="INFO" message="${/logPrefix} Abort - Number of retry attempts for status code 429 exceeded." />
                            <Abort reason="Number of retries exceeded for status code 429." />
                        </If>

                        <!-- Calculating back off time, if it is not present in header take default time -->
                        <Set path="/sleepTime" value="${/refreshTokenResponse/headers/retry-after}" />
                        <If condition="${/sleepTime = ''}">
                            <Set path="/sleepTime" value="${/defaultSleepTime}" />
                        </If>
                        <Log type="INFO" message="${/logPrefix} - Sleeping for ${/sleepTime} seconds." />
                        <Sleep duration="${/sleepTime * 1000}" />
                    </If>
                    <Else>
                        <Set path="/rateLimitErrorCount" value="${/maxRetry}" />
                    </Else>
                </While>

                <!-- Storing Refresh token and Access token from API response -->
                <If condition="${/refreshTokenResponse/status_code} = 200">
                    <Log type="INFO" message="${/logPrefix} - Refresh token and Access token created successfully." />
                    <Set path="/refreshToken" value="${/refreshTokenResponse/body/refresh_token}" />
                    <Set path="/accessToken" value="${/refreshTokenResponse/body/access_token}" />
                </If>

                <!-- Aborting execution of workflow for http status code other than 200 -->
                <Else>
                    <Log type="INFO" message="${/logPrefix} Abort - API call failed while creating Access token with status code - ${/refreshTokenResponse/status_code}, Body - ${/refreshTokenResponse/body}" />
                    <Abort reason="API call failed while creating Access token with status code - ${/refreshTokenResponse/status_code}" />
                </Else>

            </If>
            <Else>

                <Log type="INFO" message="${/logPrefix} - Refresh token found. Creating new Access token using stored Refresh token." />
                <Set path="/rateLimitErrorCount" value="0" />
                <While condition="${/rateLimitErrorCount != ${/maxRetry}}">

                    <!-- Create an Access Token using Refresh token and save response at Jpath /accessTokenResponse-->
                    <CallEndpoint url="${/vectraUrl}${/createTokenEndpoint}" method="POST" savePath="/accessTokenResponse">

                        <!-- Request header -->
                        <RequestHeader name="User-Agent" value="${/userAgentHeader}" />

                        <!-- Request body in the urlencoded format -->
                        <UrlEncodedFormRequestBody>
                            <Parameter name="grant_type" value="refresh_token" />
                            <Parameter name="Content-Type" value="application/x-www-form-urlencoded" />
                            <Parameter name="refresh_token" value="${/refreshToken}" />
                        </UrlEncodedFormRequestBody>
                    </CallEndpoint>

                    <!-- Retry 3 times if the status code is 429. i.e API Rate limit exceeded. -->
                    <If condition="${/accessTokenResponse/status_code} = 429">
                        <Set path="/rateLimitErrorCount" value="${/rateLimitErrorCount + 1}" />
                        <Log type="INFO" message="${/logPrefix} - API Rate limit exceeded. Status Code: 429." />
                        <If condition="${/rateLimitErrorCount = ${/maxRetry}}">
                            <Log type="INFO" message="${/logPrefix} Abort - Number of retry attempts for status code 429 exceeded." />
                            <Abort reason="Number of retries exceeded for status code 429." />
                        </If>

                        <!-- Calculating back off time, if it is not present in header take default time -->
                        <Set path="/sleepTime" value="${/accessTokenResponse/headers/retry-after}" />
                        <If condition="${/sleepTime = ''}">
                            <Set path="/sleepTime" value="${/defaultSleepTime}" />
                        </If>
                        <Log type="INFO" message="${/logPrefix} - Sleeping for ${/sleepTime} seconds." />
                        <Sleep duration="${/sleepTime * 1000}" />
                    </If>
                    <Else>
                        <Set path="/rateLimitErrorCount" value="${/maxRetry}" />
                    </Else>
                </While>

                <!-- Storing Access token from API response -->
                <If condition="${/accessTokenResponse/status_code} = 200">
                    <Log type="INFO" message="${/logPrefix} - Access token created successfully." />
                    <Set path="/accessToken" value="${/accessTokenResponse/body/access_token}" />
                </If>

                <!-- Incase of expired Refresh token -->
                <ElseIf condition="${/accessTokenResponse/status_code} = 401">

                    <Log type="INFO" message="${/logPrefix} - Refresh token is expired. Recreating an Access token and Refresh token using provided credentials." />
                    <Set path="/rateLimitErrorCount" value="0" />
                    <While condition="${/rateLimitErrorCount != ${/maxRetry}}">

                        <!-- Create a Refresh token and Access Token using Client ID and secret and save response at Jpath /refreshTokenResponse-->
                        <CallEndpoint url="${/vectraUrl}${/createTokenEndpoint}" method="POST" savePath="/refreshTokenResponse">

                            <!-- Implicitly convert username and password in the format of basic authentication - "Basic Base64Encode(username:password)" -->
                            <BasicAuthentication username="${/clientId}" password="${/secretKey}" />

                            <!-- Request header -->
                            <RequestHeader name="User-Agent" value="${/userAgentHeader}" />

                            <!-- Request body in the urlencoded format -->
                            <UrlEncodedFormRequestBody>
                                <Parameter name="grant_type" value="client_credentials" />
                                <Parameter name="Accept" value="application/json" />
                                <Parameter name="content-type" value="application/x-www-form-urlencoded" />
                            </UrlEncodedFormRequestBody>
                        </CallEndpoint>

                        <!-- Retry 3 times if the status code is 429. i.e API Rate limit exceeded. -->
                        <If condition="${/refreshTokenResponse/status_code} = 429">
                            <Set path="/rateLimitErrorCount" value="${/rateLimitErrorCount + 1}" />
                            <Log type="INFO" message="${/logPrefix} - API Rate limit exceeded. Status Code: 429." />
                            <If condition="${/rateLimitErrorCount = ${/maxRetry}}">
                                <Log type="INFO" message="${/logPrefix} Abort - Number of retry attempts for status code 429 exceeded." />
                                <Abort reason="Number of retries exceeded for status code 429." />
                            </If>

                            <!-- Calculating back off time, if it is not present in header take default time -->
                            <Set path="/sleepTime" value="${/refreshTokenResponse/headers/retry-after}" />
                            <If condition="${/sleepTime = ''}">
                                <Set path="/sleepTime" value="${/defaultSleepTime}" />
                            </If>
                            <Log type="INFO" message="${/logPrefix} - Sleeping for ${/sleepTime} seconds." />
                            <Sleep duration="${/sleepTime * 1000}" />
                        </If>
                        <Else>
                            <Set path="/rateLimitErrorCount" value="${/maxRetry}" />
                        </Else>
                    </While>

                    <!-- Storing Refresh token and Access token from API response -->
                    <If condition="${/refreshTokenResponse/status_code} = 200">
                        <Log type="INFO" message="${/logPrefix} - Refresh token and Access token created successfully." />
                        <Set path="/refreshToken" value="${/refreshTokenResponse/body/refresh_token}" />
                        <Set path="/accessToken" value="${/refreshTokenResponse/body/access_token}" />
                    </If>

                    <!-- Aborting execution of workflow for failed API call -->
                    <Else>
                        <Log type="INFO" message="${/logPrefix} Abort - API call failed while creating Access token with status code - ${/refreshTokenResponse/status_code}, Body - ${/refreshTokenResponse/body}" />
                        <Abort reason="API call failed while creating Access token with status code - ${/refreshTokenResponse/status_code}" />
                    </Else>
                </ElseIf>

                <!-- Aborting execution of workflow for failed API call with status code other than 200 and 401 -->
                <Else>
                    <Log type="INFO" message="${/logPrefix} Abort - API call failed while creating Access token with status code - ${/accessTokenResponse/status_code}, Body - ${/accessTokenResponse/body}" />
                    <Abort reason="API call failed while creating Access token with status code - ${/accessTokenResponse/status_code}" />
                </Else>
            </Else>

            <!-- Step 1: Base health collection (always) - /api/v3.5/health    -->
            <If condition="${/baseHealthCompleted} = false">

                <Log type="INFO" message="${/logPrefix} - Collecting health data from ${/healthEndpoint}." />

                <Set path="/rateLimitErrorCount" value="0" />
                <While condition="${/rateLimitErrorCount != ${/maxRetry}}">
                    <CallEndpoint url="${/vectraUrl}${/healthEndpoint}" method="GET" savePath="/health/response">

                        <BearerAuthentication token="${/accessToken}" />

                        <!-- Request header -->
                        <RequestHeader name="User-Agent" value="${/userAgentHeader}" />

                        <RequestBody type="application/json" encoding="UTF-8">
                    {
                        "Accept": "application/json",
                        "content-type": "application/x-www-form-urlencoded"
                    }
                        </RequestBody>

                    </CallEndpoint>

                    <!-- Retry 3 times if the status code is 429. i.e API Rate limit exceeded. -->
                    <If condition="${/health/response/status_code} = 429">
                        <Set path="/rateLimitErrorCount" value="${/rateLimitErrorCount + 1}" />
                        <Log type="INFO" message="${/logPrefix} - API Rate limit exceeded (429) while collecting health data from ${/healthEndpoint}." />
                        <If condition="${/rateLimitErrorCount = ${/maxRetry}}">
                            <Log type="INFO" message="${/logPrefix} Abort - Number of retry attempts for status code 429 exceeded while collecting health data." />
                            <Abort reason="Number of retries exceeded for status code 429." />
                        </If>

                        <!-- Calculating back off time, if it is not present in header take default time -->
                        <Set path="/sleepTime" value="${/health/response/headers/retry-after}" />
                        <If condition="${/sleepTime = ''}">
                            <Set path="/sleepTime" value="${/defaultSleepTime}" />
                        </If>
                        <Log type="INFO" message="${/logPrefix} - Sleeping for ${/sleepTime} seconds." />
                        <Sleep duration="${/sleepTime * 1000}" />
                    </If>
                    <Else>
                        <Set path="/rateLimitErrorCount" value="${/maxRetry}" />
                    </Else>
                </While>
                <If condition="/health/response/status_code = 200">

                    <ForEach item="/sensor" items="/health/response/body/sensors">

                        <Set path="/sensor_name" value="${/sensor/name}"/>
                        <Add path="/health/response/body/sensor_name_list" value="${/sensor_name}" />
                        <Add path="/health/response/body/ip_address_list" value="${/sensor/ip_address}" />
                        <Set path="/serial_number" value="${/sensor/serial_number}" />
                        <Set path="/luid" value="${/sensor/luid}" />

                        <Set path="/connectivity_sensor" value="${/health/response/body/connectivity/sensors[@serial_number = /serial_number]}" />

                        <Add path="/health/response/body/connectivity_status_list" value="${/connectivity_sensor[0]/status}" />
                        <Add path="/health/response/body/connectivity_error_list" value="${/connectivity_sensor[0]/error}" />

                        <Set path="/trafficdrop_sensor" value="${/health/response/body/trafficdrop/sensors[@serial_number = /serial_number]}" />
                        <Add path="/health/response/body/trafficdrop_status_list" value="${/trafficdrop_sensor[0]/status}" />
                        <Add path="/health/response/body/trafficdrop_error_list" value="${/trafficdrop_sensor[0]/error}" />

                        <Set path="/aggregated_peak_traffic_mbps" value="${/health/response/body/network/traffic/sensors/'${/sensor_name}'/aggregated_peak_traffic_mbps}" />
                        <Add path="/health/response/body/aggregated_peak_traffic_mbps_list" value="${/aggregated_peak_traffic_mbps}" />

                        <Set path="/luid_key" value="${keys(/health/response/body/network/interfaces/sensors/${/luid})}" />
                        <Set path="/link_status" value="UP"/>
                        <ForEach item="/each_key" items="/luid_key">
                            <Set path="/each_link_status" value="${/health/response/body/network/interfaces/sensors/${/luid}/${/each_key}/link}"/>
                            <If condition="${'${lower(/each_link_status)}' != 'up'}">
                                <Set path="/link_status" value="Degraded"/>
                            </If>
                        </ForEach>
                        <Add path="/health/response/body/link_object_list" value="${/link_status}" />
                    </ForEach>

                    <Set path="/baseHealthEvent" value="vectra_json_health:${/health/response/body}" />
                    <PostEvent path="/baseHealthEvent" />
                    <Log type="INFO" message="${/logPrefix} - Total 1 system and ${count(/health/response/body/sensors)} sensor(s) information ingested in QRadar." />

                    <Set path="/baseHealthCompleted" value="true" />
                    <!-- Progress made: reset the consecutive token-failure counter. -->
                    <Set path="/errorCount" value="0" />
                </If>
                <ElseIf condition="${/health/response/status_code} = 401">
                    <!-- To retry for 401 status code -->
                    <Set path="/errorCount" value="${/errorCount + 1}" />
                    <Log type="INFO" message="${/logPrefix} - Access token is expired with status code - 401 while collecting health data." />
                    <Set path="/accessToken" value="" />
                    <If condition="${/errorCount = ${/maxRetry}}">
                        <Log type="INFO" message="${/logPrefix} Abort - Exceeded maximum retries (${/maxRetry}) due to repeated 401 responses while collecting health data." />
                        <Abort reason="Exceeded maximum retries due to repeated 401 responses while collecting health data." />
                    </If>
                </ElseIf>
                <Else>
                    <Log type="INFO" message="${/logPrefix} Abort - API call failed while collecting health data from ${/healthEndpoint} with status code - ${/health/response/status_code}, Body - ${/health/response/body}" />
                    <Abort reason="API call failed while collecting health data with status code - ${/health/response/status_code}" />
                </Else>
            </If>

            <!-- Step 2: Optional EDR health (summary + details). -->
            <If condition="${/baseHealthCompleted} = true and ${/edrDetailsCompleted} = false">
                <If condition="${'${lower(/collectEdrHealth)}' = 'enable'}">

                    <!-- Step 2a: EDR health summary - /api/v3.5/health/edr -->
                    <If condition="${/edrSummaryCompleted} = false">

                        <Log type="INFO" message="${/logPrefix} - Collecting EDR health summary data from ${/healthEdrEndpoint}." />
                        <Set path="/rateLimitErrorCount" value="0" />
                        <While condition="${/rateLimitErrorCount != ${/maxRetry}}">
                            <CallEndpoint url="${/vectraUrl}${/healthEdrEndpoint}" method="GET" savePath="/healthEdr/response">

                                <BearerAuthentication token="${/accessToken}" />

                                <!-- Request header -->
                                <RequestHeader name="User-Agent" value="${/userAgentHeader}" />

                                <RequestBody type="application/json" encoding="UTF-8">
                            {
                                "Accept": "application/json",
                                "content-type": "application/x-www-form-urlencoded"
                            }
                                </RequestBody>

                            </CallEndpoint>

                            <!-- Retry 3 times if the status code is 429. i.e API Rate limit exceeded. -->
                            <If condition="${/healthEdr/response/status_code} = 429">
                                <Set path="/rateLimitErrorCount" value="${/rateLimitErrorCount + 1}" />
                                <Log type="INFO" message="${/logPrefix} - API Rate limit exceeded (429) while collecting EDR health summary data from ${/healthEdrEndpoint}." />
                                <If condition="${/rateLimitErrorCount = ${/maxRetry}}">
                                    <Log type="INFO" message="${/logPrefix} Abort - Number of retry attempts for status code 429 exceeded while collecting EDR health summary data." />
                                    <Abort reason="Number of retries exceeded for status code 429." />
                                </If>

                                <!-- Calculating back off time, if it is not present in header take default time -->
                                <Set path="/sleepTime" value="${/healthEdr/response/headers/retry-after}" />
                                <If condition="${/sleepTime = ''}">
                                    <Set path="/sleepTime" value="${/defaultSleepTime}" />
                                </If>
                                <Log type="INFO" message="${/logPrefix} - Sleeping for ${/sleepTime} seconds." />
                                <Sleep duration="${/sleepTime * 1000}" />
                            </If>
                            <Else>
                                <Set path="/rateLimitErrorCount" value="${/maxRetry}" />
                            </Else>
                        </While>
                        <If condition="/healthEdr/response/status_code = 200">
                            <Set path="/edrHealthEvent" value="vectra_json_health_edr:${/healthEdr/response/body}" />
                            <PostEvent path="/edrHealthEvent" />
                            <Set path="/edrSummaryCompleted" value="true" />
                            <!-- Progress made: reset the consecutive token-failure counter. -->
                            <Set path="/errorCount" value="0" />
                            <Log type="INFO" message="${/logPrefix} - EDR health summary event ingested in QRadar." />
                        </If>
                        <ElseIf condition="${/healthEdr/response/status_code} = 401">
                            <Set path="/errorCount" value="${/errorCount + 1}" />
                            <Log type="INFO" message="${/logPrefix} - Access token is expired with status code - 401 while collecting EDR health summary data." />
                            <Set path="/accessToken" value="" />
                            <If condition="${/errorCount = ${/maxRetry}}">
                                <Log type="INFO" message="${/logPrefix} Abort - Exceeded maximum retries (${/maxRetry}) due to repeated 401 responses while collecting EDR health summary data." />
                                <Abort reason="Exceeded maximum retries due to repeated 401 responses while collecting EDR health summary data." />
                            </If>
                        </ElseIf>
                        <Else>
                            <Log type="INFO" message="${/logPrefix} Abort - API call failed while collecting EDR health summary data from ${/healthEdrEndpoint} with status code - ${/healthEdr/response/status_code}, Body - ${/healthEdr/response/body}" />
                            <Abort reason="API call failed while collecting EDR health summary data with status code - ${/healthEdr/response/status_code}" />
                        </Else>
                    </If>

                    <!-- Step 2b: EDR health details - /api/v3.5/health/edr/details -->
                    <If condition="${/edrSummaryCompleted} = true and ${/edrDetailsCompleted} = false">

                        <Log type="INFO" message="${/logPrefix} - Collecting EDR health details data from ${/healthEdrDetailsEndpoint}." />
                        <Set path="/rateLimitErrorCount" value="0" />
                        <While condition="${/rateLimitErrorCount != ${/maxRetry}}">
                            <CallEndpoint url="${/vectraUrl}${/healthEdrDetailsEndpoint}" method="GET" savePath="/healthEdrDetails/response">

                                <BearerAuthentication token="${/accessToken}" />

                                <!-- Request header -->
                                <RequestHeader name="User-Agent" value="${/userAgentHeader}" />

                                <RequestBody type="application/json" encoding="UTF-8">
                            {
                                "Accept": "application/json",
                                "content-type": "application/x-www-form-urlencoded"
                            }
                                </RequestBody>

                            </CallEndpoint>

                            <!-- Retry 3 times if the status code is 429. i.e API Rate limit exceeded. -->
                            <If condition="${/healthEdrDetails/response/status_code} = 429">
                                <Set path="/rateLimitErrorCount" value="${/rateLimitErrorCount + 1}" />
                                <Log type="INFO" message="${/logPrefix} - API Rate limit exceeded (429) while collecting EDR health details data from ${/healthEdrDetailsEndpoint}." />
                                <If condition="${/rateLimitErrorCount = ${/maxRetry}}">
                                    <Log type="INFO" message="${/logPrefix} Abort - Number of retry attempts for status code 429 exceeded while collecting EDR health details data." />
                                    <Abort reason="Number of retries exceeded for status code 429." />
                                </If>

                                <!-- Calculating back off time, if it is not present in header take default time -->
                                <Set path="/sleepTime" value="${/healthEdrDetails/response/headers/retry-after}" />
                                <If condition="${/sleepTime = ''}">
                                    <Set path="/sleepTime" value="${/defaultSleepTime}" />
                                </If>
                                <Log type="INFO" message="${/logPrefix} - Sleeping for ${/sleepTime} seconds." />
                                <Sleep duration="${/sleepTime * 1000}" />
                            </If>
                            <Else>
                                <Set path="/rateLimitErrorCount" value="${/maxRetry}" />
                            </Else>
                        </While>
                        <If condition="/healthEdrDetails/response/status_code = 200">
                            <Set path="/edrHealthDetailsEvent" value="vectra_json_health_edr_details:${/healthEdrDetails/response/body}" />
                            <PostEvent path="/edrHealthDetailsEvent" />
                            <Set path="/edrDetailsCompleted" value="true" />
                            <!-- Progress made: reset the consecutive token-failure counter. -->
                            <Set path="/errorCount" value="0" />
                            <Log type="INFO" message="${/logPrefix} - EDR health details event ingested in QRadar." />
                        </If>
                        <ElseIf condition="${/healthEdrDetails/response/status_code} = 401">
                            <Set path="/errorCount" value="${/errorCount + 1}" />
                            <Log type="INFO" message="${/logPrefix} - Access token is expired with status code - 401 while collecting EDR health details data." />
                            <Set path="/accessToken" value="" />
                            <If condition="${/errorCount = ${/maxRetry}}">
                                <Log type="INFO" message="${/logPrefix} Abort - Exceeded maximum retries (${/maxRetry}) due to repeated 401 responses while collecting EDR health details data." />
                                <Abort reason="Exceeded maximum retries due to repeated 401 responses while collecting EDR health details data." />
                            </If>
                        </ElseIf>
                        <Else>
                            <Log type="INFO" message="${/logPrefix} Abort - API call failed while collecting EDR health details data from ${/healthEdrDetailsEndpoint} with status code - ${/healthEdrDetails/response/status_code}, Body - ${/healthEdrDetails/response/body}" />
                            <Abort reason="API call failed while collecting EDR health details data with status code - ${/healthEdrDetails/response/status_code}" />
                        </Else>
                    </If>

                </If>
                <Else>
                    <!-- EDR health collection disabled. Mark its sub-steps resolved so the flow proceeds. -->
                    <Set path="/edrSummaryCompleted" value="true" />
                    <Set path="/edrDetailsCompleted" value="true" />
                    <Log type="INFO" message="${/logPrefix} - EDR health collection is disabled (collectEdrHealth = ${/collectEdrHealth})." />
                </Else>
            </If>

            <!-- Step 3: Optional external connectors health (summary + details). -->
            <If condition="${/baseHealthCompleted} = true and ${/edrDetailsCompleted} = true and ${/externalDetailsCompleted} = false">
                <If condition="${'${lower(/collectExternalConnectorsHealth)}' = 'enable'}">

                    <!-- Step 3a: External connectors health summary - /api/v3.5/health/external_connectors -->
                    <If condition="${/externalSummaryCompleted} = false">

                        <Log type="INFO" message="${/logPrefix} - Collecting external connectors health summary data from ${/healthExternalConnectorsEndpoint}." />
                        <Set path="/rateLimitErrorCount" value="0" />
                        <While condition="${/rateLimitErrorCount != ${/maxRetry}}">
                            <CallEndpoint url="${/vectraUrl}${/healthExternalConnectorsEndpoint}" method="GET" savePath="/healthExternalConnectors/response">

                                <BearerAuthentication token="${/accessToken}" />

                                <!-- Request header -->
                                <RequestHeader name="User-Agent" value="${/userAgentHeader}" />

                                <RequestBody type="application/json" encoding="UTF-8">
                            {
                                "Accept": "application/json",
                                "content-type": "application/x-www-form-urlencoded"
                            }
                                </RequestBody>

                            </CallEndpoint>

                            <!-- Retry 3 times if the status code is 429. i.e API Rate limit exceeded. -->
                            <If condition="${/healthExternalConnectors/response/status_code} = 429">
                                <Set path="/rateLimitErrorCount" value="${/rateLimitErrorCount + 1}" />
                                <Log type="INFO" message="${/logPrefix} - API Rate limit exceeded (429) while collecting external connectors health summary data from ${/healthExternalConnectorsEndpoint}." />
                                <If condition="${/rateLimitErrorCount = ${/maxRetry}}">
                                    <Log type="INFO" message="${/logPrefix} Abort - Number of retry attempts for status code 429 exceeded while collecting external connectors health summary data." />
                                    <Abort reason="Number of retries exceeded for status code 429." />
                                </If>

                                <!-- Calculating back off time, if it is not present in header take default time -->
                                <Set path="/sleepTime" value="${/healthExternalConnectors/response/headers/retry-after}" />
                                <If condition="${/sleepTime = ''}">
                                    <Set path="/sleepTime" value="${/defaultSleepTime}" />
                                </If>
                                <Log type="INFO" message="${/logPrefix} - Sleeping for ${/sleepTime} seconds." />
                                <Sleep duration="${/sleepTime * 1000}" />
                            </If>
                            <Else>
                                <Set path="/rateLimitErrorCount" value="${/maxRetry}" />
                            </Else>
                        </While>
                        <If condition="/healthExternalConnectors/response/status_code = 200">
                            <Set path="/externalConnectorsHealthEvent" value="vectra_json_health_external_connectors:${/healthExternalConnectors/response/body}" />
                            <PostEvent path="/externalConnectorsHealthEvent" />
                            <Set path="/externalSummaryCompleted" value="true" />
                            <!-- Progress made: reset the consecutive token-failure counter. -->
                            <Set path="/errorCount" value="0" />
                            <Log type="INFO" message="${/logPrefix} - External connectors health summary event ingested in QRadar." />
                        </If>
                        <ElseIf condition="${/healthExternalConnectors/response/status_code} = 401">
                            <Set path="/errorCount" value="${/errorCount + 1}" />
                            <Log type="INFO" message="${/logPrefix} - Access token is expired with status code - 401 while collecting external connectors health summary data." />
                            <Set path="/accessToken" value="" />
                            <If condition="${/errorCount = ${/maxRetry}}">
                                <Log type="INFO" message="${/logPrefix} Abort - Exceeded maximum retries (${/maxRetry}) due to repeated 401 responses while collecting external connectors health summary data." />
                                <Abort reason="Exceeded maximum retries due to repeated 401 responses while collecting external connectors health summary data." />
                            </If>
                        </ElseIf>
                        <Else>
                            <Log type="INFO" message="${/logPrefix} Abort - API call failed while collecting external connectors health summary data from ${/healthExternalConnectorsEndpoint} with status code - ${/healthExternalConnectors/response/status_code}, Body - ${/healthExternalConnectors/response/body}" />
                            <Abort reason="API call failed while collecting external connectors health summary data with status code - ${/healthExternalConnectors/response/status_code}" />
                        </Else>
                    </If>

                    <!-- Step 3b: External connectors health details - /api/v3.5/health/external_connectors/details -->
                    <If condition="${/externalSummaryCompleted} = true and ${/externalDetailsCompleted} = false">

                        <Log type="INFO" message="${/logPrefix} - Collecting external connectors health details data from ${/healthExternalConnectorsDetailsEndpoint}." />
                        <Set path="/rateLimitErrorCount" value="0" />
                        <While condition="${/rateLimitErrorCount != ${/maxRetry}}">
                            <CallEndpoint url="${/vectraUrl}${/healthExternalConnectorsDetailsEndpoint}" method="GET" savePath="/healthExternalConnectorsDetails/response">

                                <BearerAuthentication token="${/accessToken}" />

                                <!-- Request header -->
                                <RequestHeader name="User-Agent" value="${/userAgentHeader}" />

                                <RequestBody type="application/json" encoding="UTF-8">
                            {
                                "Accept": "application/json",
                                "content-type": "application/x-www-form-urlencoded"
                            }
                                </RequestBody>

                            </CallEndpoint>

                            <!-- Retry 3 times if the status code is 429. i.e API Rate limit exceeded. -->
                            <If condition="${/healthExternalConnectorsDetails/response/status_code} = 429">
                                <Set path="/rateLimitErrorCount" value="${/rateLimitErrorCount + 1}" />
                                <Log type="INFO" message="${/logPrefix} - API Rate limit exceeded (429) while collecting external connectors health details data from ${/healthExternalConnectorsDetailsEndpoint}." />
                                <If condition="${/rateLimitErrorCount = ${/maxRetry}}">
                                    <Log type="INFO" message="${/logPrefix} Abort - Number of retry attempts for status code 429 exceeded while collecting external connectors health details data." />
                                    <Abort reason="Number of retries exceeded for status code 429." />
                                </If>

                                <!-- Calculating back off time, if it is not present in header take default time -->
                                <Set path="/sleepTime" value="${/healthExternalConnectorsDetails/response/headers/retry-after}" />
                                <If condition="${/sleepTime = ''}">
                                    <Set path="/sleepTime" value="${/defaultSleepTime}" />
                                </If>
                                <Log type="INFO" message="${/logPrefix} - Sleeping for ${/sleepTime} seconds." />
                                <Sleep duration="${/sleepTime * 1000}" />
                            </If>
                            <Else>
                                <Set path="/rateLimitErrorCount" value="${/maxRetry}" />
                            </Else>
                        </While>
                        <If condition="/healthExternalConnectorsDetails/response/status_code = 200">
                            <Set path="/externalConnectorsHealthDetailsEvent" value="vectra_json_health_external_connectors_details:${/healthExternalConnectorsDetails/response/body}" />
                            <PostEvent path="/externalConnectorsHealthDetailsEvent" />
                            <Set path="/externalDetailsCompleted" value="true" />
                            <!-- Progress made: reset the consecutive token-failure counter. -->
                            <Set path="/errorCount" value="0" />
                            <Log type="INFO" message="${/logPrefix} - External connectors health details event ingested in QRadar." />
                        </If>
                        <ElseIf condition="${/healthExternalConnectorsDetails/response/status_code} = 401">
                            <Set path="/errorCount" value="${/errorCount + 1}" />
                            <Log type="INFO" message="${/logPrefix} - Access token is expired with status code - 401 while collecting external connectors health details data." />
                            <Set path="/accessToken" value="" />
                            <If condition="${/errorCount = ${/maxRetry}}">
                                <Log type="INFO" message="${/logPrefix} Abort - Exceeded maximum retries (${/maxRetry}) due to repeated 401 responses while collecting external connectors health details data." />
                                <Abort reason="Exceeded maximum retries due to repeated 401 responses while collecting external connectors health details data." />
                            </If>
                        </ElseIf>
                        <Else>
                            <Log type="INFO" message="${/logPrefix} Abort - API call failed while collecting external connectors health details data from ${/healthExternalConnectorsDetailsEndpoint} with status code - ${/healthExternalConnectorsDetails/response/status_code}, Body - ${/healthExternalConnectorsDetails/response/body}" />
                            <Abort reason="API call failed while collecting external connectors health details data with status code - ${/healthExternalConnectorsDetails/response/status_code}" />
                        </Else>
                    </If>

                </If>
                <Else>
                    <!-- External connectors health collection disabled. Mark its sub-steps resolved so the flow proceeds. -->
                    <Set path="/externalSummaryCompleted" value="true" />
                    <Set path="/externalDetailsCompleted" value="true" />
                    <Log type="INFO" message="${/logPrefix} - External connectors health collection is disabled (collectExternalConnectorsHealth = ${/collectExternalConnectorsHealth})." />
                </Else>
            </If>

            <!-- All applicable steps finished: stop the workflow cleanly. -->
            <If condition="${/baseHealthCompleted} = true and ${/edrDetailsCompleted} = true and ${/externalDetailsCompleted} = true">
                <Set path="/errorCount" value="${/maxRetry}"/>
                <Log type="INFO" message="${/logPrefix} - Health events collection completed." />
            </If>
        </While>
    </Actions>

    <!-- Performing some connectivity tests -->
    <Tests>
        <DNSResolutionTest host="${/vectraHostName}" />
        <TCPConnectionTest host="${/vectraHostName}" />
        <SSLHandshakeTest host="${/vectraHostName}" />
        <HTTPConnectionThroughProxyTest url="https://${/vectraHostName}" />
    </Tests>
</Workflow>